# Copy to .env and fill in real values. .env is git-ignored; never commit it.

# --- Hindsight long-term memory ---------------------------------------------
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=field-service-copilot
# Set to true to split memory into one bank per fleet
# (<bank>-chillers, <bank>-solar, <bank>-elevators). Seeder and backend both honour it.
HINDSIGHT_PER_FLEET_BANKS=false
# Interactive recall budget in seconds. Past this, the agent answers from local retrieval while the
# Hindsight result finishes in the background and warms the cache for the next question.
HINDSIGHT_TIMEOUT_S=1.5
# Retain budget per attempt (retried with backoff). Retains run after the answer is shown, so they
# never block a technician; anything that still fails waits in the local outbox and syncs later.
HINDSIGHT_RETAIN_TIMEOUT_S=15
# Reflect is an LLM synthesis on the Hindsight side (~15 s); it runs in the background and is cached.
HINDSIGHT_REFLECT_TIMEOUT_S=45
# Warm the reflection cache at startup for faults where field evidence contradicts the manual.
HINDSIGHT_PREWARM=true

# --- Groq LLM ----------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# Only sent for openai/gpt-oss-* models: low | medium | high
GROQ_REASONING_EFFORT=medium
GROQ_MAX_RETRIES=4

# --- App ---------------------------------------------------------------------
PORT=8000
ENVIRONMENT=development
# Comma-separated origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
