            "procedure": [
              "Take the car out of service and follow hoistway entry safety procedures.",
              "Check encoder coupling and mounting screws.",
              "Run the encoder self-test (KDL16 › Diagnostics › Encoder).",
              "Replace motor encoder P/N KM-ENC-2048 and run a motor identification run.",
              "Verify floor levelling accuracy of ±5 mm at every landing."
            ],
            "primary_action": "Replace motor encoder KM-ENC-2048 and run motor ID",
            "parts": [{"part": "KM-ENC-2048 motor encoder", "cost_usd": 1900}],
            "est_labor_hours": 6.0
          }
        },
        "F-119": {
          "title": "Brake release monitoring fault",
          "severity": "major",
          "manual": {
            "section": "§3.2 Machinery brake",
            "probable_causes": ["Brake air gap out of tolerance", "Worn release-monitoring microswitch"],
            "procedure": [
              "Measure the brake air gap; tolerance is 0.35–0.45 mm.",
              "Adjust the air gap to 0.40 mm.",
              "Test the release microswitch; replace it if contact bounce exceeds 5 ms.",
              "Run 10 test cycles and confirm no fault."
            ],
            "primary_action": "Adjust brake air gap to 0.40 mm and test release microswitch",
            "parts": [],
            "est_labor_hours": 2.0
          }
        }
      }
