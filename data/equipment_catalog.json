    "carrier-30xa": {
      "name": "Carrier AquaForce 30XA",
      "fleet": "chillers",
      "category": "Air-cooled screw chiller with VFD compressors",
      "aliases": ["carrier aquaforce 30xa", "aquaforce 30xa", "aquaforce", "carrier 30xa", "30xa", "carrier chiller", "chiller model 30xa"],
      "manual_doc": "30XA Service Manual SM-30XA-24 Rev C",
      "error_codes": {
        "E-412": {
          "title": "Compressor A1 inverter overcurrent trip",
          "severity": "critical",
          "manual": {
            "section": "§7.4 Inverter faults",
            "probable_causes": [
              "Failed inverter (VFD) power module or drive board",
              "Compressor motor winding insulation breakdown",
              "Supply voltage imbalance above 2%"
            ],
            "procedure": [
              "Apply lockout/tagout on the main disconnect. Wait 5 minutes for DC bus discharge and verify < 50 V DC at the bus terminals.",
              "Measure line-to-line supply voltage. Imbalance must be ≤ 2%.",
              "Megger compressor A1 motor windings at 1000 V DC. Insulation must exceed 100 MΩ.",
              "If supply and windings are within spec, replace inverter drive board P/N 30XA-VFD-412B.",
              "Clear the alarm, restart, and run compressor A1 at 50% load for 30 minutes while logging current."
            ],
            "primary_action": "Replace inverter drive board 30XA-VFD-412B",
            "parts": [{"part": "30XA-VFD-412B inverter drive board", "cost_usd": 4850}],
            "est_labor_hours": 6.0
          }
        },
        "E-221": {
          "title": "Leaving chilled-water temperature sensor deviation",
          "severity": "major",
          "manual": {
            "section": "§5.2 Temperature sensors",
            "probable_causes": [
              "Failed leaving-water thermistor",
              "Open or shorted sensor wiring",
              "Controller analog input fault"
            ],
            "procedure": [
              "Compare the controller LWT reading against a calibrated reference probe. A deviation above 1.0 °C is out of tolerance.",
              "Measure thermistor resistance and compare against the 10 kΩ NTC chart.",
              "Replace leaving-water thermistor P/N 30XA-THM-10K.",
              "Verify the reading is within ±0.5 °C of the reference probe."
            ],
            "primary_action": "Replace leaving-water thermistor 30XA-THM-10K",
            "parts": [{"part": "30XA-THM-10K thermistor", "cost_usd": 85}],
            "est_labor_hours": 1.5
          }
        },
        "E-118": {
          "title": "Condenser fan VFD fault",
          "severity": "minor",
          "manual": {
            "section": "§6.1 Condenser fans",
            "probable_causes": ["Pitted fan contactor K3", "Fan VFD fault latch", "Fan motor bearing failure"],
            "procedure": [
              "Isolate the fan circuit and inspect contactor K3 contacts.",
              "Read the fan VFD fault log; clear latched faults.",
              "Replace contactor K3 if contacts are pitted, then reset the fan VFD.",
              "Run all condenser fans at 100% for 10 minutes."
            ],
            "primary_action": "Replace condenser fan contactor K3 and reset fan VFD",
            "parts": [{"part": "K3 fan contactor", "cost_usd": 140}],
            "est_labor_hours": 1.5
          }
        }
      }
    },
    "apex-inv9000": {
      "name": "Apex Solar Inverter INV-9000",
      "fleet": "solar",
      "category": "100 kW three-phase string inverter",
      "aliases": ["apex solar inverter inv-9000", "apex inv-9000", "inv-9000", "inv9000", "apex inverter", "apex solar inverter"],
      "manual_doc": "INV-9000 Installation & Service Guide v4.2",
      "error_codes": {
        "GF-17": {
          "title": "Ground fault: DC insulation resistance (Riso) below 100 kΩ",
          "severity": "critical",
          "manual": {
            "section": "§9.3 Ground-fault detection (GFDI)",
            "probable_causes": [
              "GFDI false trip (addressed in firmware v4.2.1)",
              "DC input board isolation-monitor fault",
              "Damaged PV string insulation"
            ],
            "procedure": [
              "Isolate AC and DC sides and verify zero energy.",
              "Perform a GFDI reset: Settings › Maintenance › Reset GFDI.",
              "Update firmware to v4.2.1 or later.",
              "Measure Riso per string at 1000 V; isolate strings below 1 MΩ.",
              "If every string passes and the fault persists, replace DC input board P/N INV9-DCB-02."
            ],
            "primary_action": "GFDI reset and firmware update to v4.2.1",
            "parts": [],
            "est_labor_hours": 2.5
          }
        },
        "OT-05": {
          "title": "Heatsink over-temperature derate",
          "severity": "major",
          "manual": {
            "section": "§8.2 Thermal management",
            "probable_causes": ["Cooling fan failure", "Blocked air intake", "Outdated thermal derating curve (firmware < v4.2.1)"],
            "procedure": [
              "Run Diagnostics › Fan test and record fan RPM.",
              "Inspect and clean the intake filter.",
              "Update firmware to v4.2.1.",
              "Replace cooling fan assembly INV9-FAN-120 if RPM is below 80% of rated."
            ],
            "primary_action": "Replace cooling fan assembly INV9-FAN-120 and update firmware",
            "parts": [{"part": "INV9-FAN-120 fan assembly", "cost_usd": 620}],
            "est_labor_hours": 2.5
          }
        },
        "COM-31": {
          "title": "Modbus RS-485 communication loss with SCADA",
          "severity": "minor",
          "manual": {
            "section": "§10.1 Communications",
            "probable_causes": ["Missing 120 Ω termination", "Loose comms card", "Address or baud mismatch"],
            "procedure": [
              "Verify the 120 Ω termination resistor at the end of the RS-485 chain.",
              "Reseat the comms card.",
              "Confirm Modbus address and baud rate against the SCADA register map."
            ],
            "primary_action": "Restore 120 Ω termination and reseat RS-485 comms card",
            "parts": [],
            "est_labor_hours": 1.0
          }
        }
      }
    },
